# =============================================================================
# .htaccess - Hostinger (Apache) deployment config for a Vite SPA
# Place this file in the same folder as index.html on your Hostinger
# hosting (e.g. public_html/, or public_html/timber-app/ for a sub-folder
# deployment - see vite.config.js VITE_BASE_PATH notes).
# =============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If deploying into a sub-folder, uncomment and set it to match
  # VITE_BASE_PATH used at build time, e.g. /timber-app/
  # RewriteBase /timber-app/

  # Let real files and directories (JS/CSS/images/manifest/service worker)
  # be served normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else (client-side routes like /calculator, /quotation/123,
  # /admin) falls back to index.html so React Router can handle it.
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Caching: long cache for hashed build assets, no cache for the shell ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "service-worker\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Gzip compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Basic security headers ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
